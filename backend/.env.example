NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://kalenda:kalenda_dev@localhost:5432/kalenda

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_32_plus_char_random_hex_string_here_aaa
JWT_REFRESH_SECRET=replace_with_different_32_plus_char_random_hex_here_bbb
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12

# CORS — set to your frontend domain in production
CORS_ORIGIN=http://localhost:5173
# Production: CORS_ORIGIN=https://yourdomain.com

# File uploads
UPLOADS_DIR=uploads
PUBLIC_URL=http://localhost:3001
# Production: PUBLIC_URL=https://api.yourdomain.com

# Firebase Admin SDK — from Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The private key includes literal \n — paste it exactly as it appears in the JSON file
FIREBASE_PRIVATE_KEY=
