{
  "appId": "com.kalenda.app",
  "appName": "Kalenda",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "iosSpinnerStyle": "small",
      "spinnerColor": "#f59e0b",
      "showSpinner": true
    },
    "StatusBar": {
      "style": "DEFAULT",
      "backgroundColor": "#ffffff"
    }
  }
}
